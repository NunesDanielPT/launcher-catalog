  "launcher": {
    "repo": "NunesDanielPT/launcher-catalog",
    "asset": "^ShowKit-Setup\\.exe$",
    "silentArgs": [
      "/S"
    ]
  },
  "donations": {
    "enabled": false,
    "url": "",
    "mode": "test",
    "methods": [
      "mbway"
    ],
    "mbway": {
      "endpoint": ""
    },
    "_nota": "mode: off | test | live. test = MB WAY simulado (nada é cobrado). live = precisa de mbway.endpoint no servidor. Outros métodos: enabled=true + url com {amount} {frequency} {method} {name} {message}."
  },
  "apps": [
    {
      "id": "videohost-player",
      "name": "VIDEOHOST",
      "nameAccent": " PLAYER",
      "accent": "#ff8a1f",
      "icon": "icons/videohost-player.png",
      "repo": "NunesDanielPT/VIDEOHOST-PLAYER",
      "category": {
        "pt": "Player de vídeo para espetáculos",
        "en": "Show video player"
      },
      "tagline": {
        "pt": "Playlist de cues para correr vídeos num espetáculo, sem o ecrã cair.",
        "en": "A cue playlist to run video in a show, without the output ever dropping."
      },
      "description": {
        "pt": "Prepara a sequência de vídeos com preview e forma de onda, e dispara cue a cue em ecrã inteiro ou por NDI, com countdown na rede e Show Mode. Se algo falhar, o motor reinicia sozinho no mesmo cue e posição.",
        "en": "Build the video running order with preview and waveform, then fire cue by cue to fullscreen or NDI, with a network countdown and Show Mode. If anything fails, the engine restarts on its own at the same cue and position."
      },
      "asset": "^VIDEOHOST-PLAYER-Setup-.*\\.exe$",
      "silentArgs": [
        "/VERYSILENT",
        "/SUPPRESSMSGBOXES",
        "/NORESTART",
        "/CLOSEAPPLICATIONS"
      ],
      "detect": {
        "registryKey": "{7B3C9E21-4A6D-4F0B-9C55-2E1D8A6F4B10}_is1",
        "displayName": "VIDEOHOST PLAYER"
      },
      "exe": "vthost-studio.exe",
      "uninstallArgs": [
        "/VERYSILENT",
        "/SUPPRESSMSGBOXES",
        "/NORESTART"
      ]
    },
    {
      "id": "playerslice",
      "name": "PLAYER",
      "nameAccent": "SLICE",
      "accent": "#3b6cff",
      "icon": "icons/playerslice.png",
      "repo": "NunesDanielPT/PlayerSlice",
      "category": {
        "pt": "Ledwalls fora de formato",
        "en": "Odd-shaped LED walls"
      },
      "tagline": {
        "pt": "Cada vídeo no sítio certo de cada ledwall.",
        "en": "Every video in the right spot on every LED wall."
      },
      "description": {
        "pt": "Várias saídas da gráfica (monitores, projetores, processadores LED) a partir de uma composição grande, recortada em slices com posição, tamanho, rotação e perspetiva. Vídeos em qualquer formato, layers e colunas, Preview/Programa, timecode SMPTE, controlo por OSC (Companion) e codecs HAP, ProRes e DNxHR.",
        "en": "Multiple GPU outputs (monitors, projectors, LED processors) from one large composition, cut into slices with position, size, rotation and perspective. Videos in any format, layers and columns, Preview/Program, SMPTE timecode, OSC control (Companion) and HAP, ProRes and DNxHR codecs."
      },
      "asset": "^PLAYERSLICE-Setup\\.exe$",
      "silentArgs": [
        "/VERYSILENT",
        "/SUPPRESSMSGBOXES",
        "/NORESTART",
        "/CLOSEAPPLICATIONS"
      ],
      "detect": {
        "registryKey": "{6B0C4C2E-5A51-4F0B-9E0C-2C7D9A1F5E11}_is1",
        "displayName": "PLAYERSLICE"
      },
      "exe": "PLAYERSLICE.exe",
      "uninstallArgs": [
        "/VERYSILENT",
        "/SUPPRESSMSGBOXES",
        "/NORESTART"
      ]
    },
    {
      "id": "mapsim",
      "name": "Map",
      "nameAccent": "Sim",
      "accent": "#1ec8f0",
      "icon": "icons/mapsim.png",
      "repo": "NunesDanielPT/MAPSIM-releases",
      "category": {
        "pt": "Simulação de projeção e LED walls",
        "en": "Projection and LED wall simulator"
      },
      "tagline": {
        "pt": "Projeção e LED walls planeados ao pormenor antes de chegar ao terreno.",
        "en": "Projection and LED walls planned in detail before you get on site."
      },
      "description": {
        "pt": "PROJEÇÃO — projetores e lentes reais (Panasonic, Epson, Barco, Christie, Sony) em ecrãs, cúpulas, salas imersivas e fachadas: distâncias, lens shift, lux, densidade, blending e arrays em truss, com o conteúdo simulado na superfície e exportação para WATCHOUT, PIXERA e Resolume.\nLED WALL — ecrãs com cabinets reais (pitch, resolução, peso e consumo), LED curvo, estrutura e ground stacks, cablagem de dados e energia automática por processador com backup, e documentação técnica em PDF. Requer licença.",
        "en": "PROJECTION — real projectors and lenses (Panasonic, Epson, Barco, Christie, Sony) on screens, domes, immersive rooms and façades: throw distances, lens shift, lux, density, blending and truss arrays, with content simulated on the surface and export to WATCHOUT, PIXERA and Resolume.\nLED WALL — screens built from real cabinets (pitch, resolution, weight and power), curved LED, structure and ground stacks, automatic data and power cabling per processor with backup, and technical PDF documentation. Licence required."
      },
      "asset": "^MapSim-Setup\\.exe$",
      "silentArgs": [
        "/S"
      ],
      "detect": {
        "displayName": "MapSim"
      },
      "exe": "MapSim.exe",
      "uninstallArgs": [
        "/S"
      ]
    },
    {
      "id": "renderpro",
      "name": "Render",
      "nameAccent": "PRO",
      "accent": "#ff4fa3",
      "icon": "icons/renderpro.png",
      "repo": "NunesDanielPT/RenderPRO",
      "category": {
        "pt": "Conversor de codecs",
        "en": "Codec converter"
      },
      "tagline": {
        "pt": "Vídeos prontos para o PLAYERSLICE e o VIDEOHOST PLAYER num clique.",
        "en": "Videos ready for PLAYERSLICE and VIDEOHOST PLAYER in one click."
      },
      "description": {
        "pt": "Arrastas os vídeos, escolhes o player e carregas em RENDER: cada vídeo passa para o codec, tamanho e frame rate recomendados (HAP, HAP Alpha, HAP Q, H.264, H.265), com som, frame rate constante e normalização opcional.\nCada ficheiro é verificado antes de ser entregue, e o original nunca é alterado.",
        "en": "Drop your videos, pick the player and press RENDER: each video is converted to the recommended codec, size and frame rate (HAP, HAP Alpha, HAP Q, H.264, H.265), with audio, constant frame rate and optional loudness normalisation.\nEvery file is checked before it is delivered, and the original is never touched."
      },
      "asset": "^RenderPRO-Setup\\.exe$",
      "silentArgs": [
        "/S"
      ],
      "detect": {
        "registryKey": "RenderPRO",
        "displayName": "RenderPRO"
      },
      "exe": "RenderPRO.exe",
      "uninstallArgs": [
        "/S"
      ]
    }
  ],
